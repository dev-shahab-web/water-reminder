<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingTop="8dp" android:paddingBottom="8dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/notification_capacity"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/notification_accent" android:textSize="11sp"
            android:textStyle="bold" android:letterSpacing="0.07"
            android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/notification_title"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textColor="@color/notification_ink"
            android:textSize="18sp" android:textStyle="bold" android:maxLines="2"
            android:ellipsize="end" />
        <TextView android:id="@+id/notification_message"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textColor="@color/notification_secondary"
            android:textSize="13sp" android:maxLines="3" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
